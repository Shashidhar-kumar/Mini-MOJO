<%- include('../partials/header') %>

<section class="narrow">

  <h1>Log in</h1>

  <%- include('../partials/errors') %>

  <form method="POST" action="/login" class="form">

    <label>
      Email
      <input
        type="email"
        name="email"
        value="<%= values.email || '' %>"
        required
        autofocus
      >
    </label>

    <label>
      Password
      <input
        type="password"
        name="password"
        required
      >
    </label>

    <button class="btn primary">Log in</button>

  </form>

  <p class="muted">
    No account?
    <a href="/register">Register as a recruiter</a>
  </p>

</section>

<%- include('../partials/footer') %>