<%- include('../partials/header') %>

<section class="narrow">

  <h1>Create account</h1>

  <%- include('../partials/errors') %>

  <form method="POST" action="/register" class="form">

    <label>
      Name
      <input
        name="name"
        value="<%= values.name || '' %>"
        required
        autofocus
      >
    </label>

    <label>
      Email
      <input
        type="email"
        name="email"
        value="<%= values.email || '' %>"
        required
      >
    </label>

    <label>
      Password
      <input
        type="password"
        name="password"
        minlength="6"
        required
      >
    </label>

    <label>
      Confirm password
      <input
        type="password"
        name="confirmPassword"
        required
      >
    </label>

    <button class="btn primary">Register</button>

  </form>

  <p class="muted">
    Already registered?
    <a href="/login">Log in</a>
  </p>

</section>

<%- include('../partials/footer') %>