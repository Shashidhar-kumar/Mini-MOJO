<%- include('../partials/header') %>

<div class="page-head">
  <h1><%= heading %></h1>
</div>

<%- include('../partials/errors') %>

<form method="POST" action="<%= action %>" class="form">

  <label>
    Title
    <input
      name="title"
      value="<%= job.title || '' %>"
      required
    >
  </label>

  <label>
    Company
    <input
      name="company"
      value="<%= job.company || '' %>"
      required
    >
  </label>

  <label>
    Location
    <input
      name="location"
      value="<%= job.location || '' %>"
    >
  </label>

  <label>
    Description
    <textarea
      name="description"
      rows="5"
    ><%= job.description || '' %></textarea>
  </label>

  <label>
    Status

    <select name="status">
      <% ['Open', 'Closed'].forEach(function (s) { %>

        <option
          <%= job.status === s ? 'selected' : '' %>
        >
          <%= s %>
        </option>

      <% }); %>
    </select>

  </label>

  <div class="rowactions">
    <button class="btn primary">Save</button>
    <a href="/jobs">Cancel</a>
  </div>

</form>

<%- include('../partials/footer') %>