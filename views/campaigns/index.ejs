<%- include('../partials/header') %>

<div class="page-head">
  <h1>Campaigns</h1>
  <a class="btn primary" href="/campaigns/new">New campaign</a>
</div>

<% if (!rows.length) { %>

  <p class="muted">
    No campaigns yet. Create a job first, then a campaign for it.
  </p>

<% } else { %>

<div class="tablewrap">
<table>

  <thead>
    <tr>
      <th>Campaign</th>
      <th>Job</th>
      <th>Status</th>
      <th class="n">Budget</th>
      <th class="n">Spent</th>
      <th class="n">Applicants</th>
      <th class="n">CPA</th>
      <th class="n">Qualified CPA</th>

      <% if (user.role === 'admin') { %>
        <th>Recruiter</th>
      <% } %>

      <th></th>
    </tr>
  </thead>

  <tbody>

  <% rows.forEach(function (r) {
       var c = r.campaign,
           s = r.summary;
  %>

    <tr>

      <td class="name">
        <a href="/campaigns/<%= c._id %>">
          <%= c.title %>
        </a>
      </td>

      <td>
        <%= c.job ? c.job.title : '–' %>
      </td>

      <td>
        <span class="badge <%= c.status.toLowerCase() %>">
          <%= c.status %>
        </span>
      </td>

      <td class="n">
        <%= money(c.totalBudget) %>
      </td>

      <td class="n">
        <%= money(s.totalSpent) %>
      </td>

      <td class="n">
        <%= s.totalApps %>
      </td>

      <td class="n">
        <%= s.totalApps ? money(s.avgCPA) : '–' %>
      </td>

      <td class="n">
        <%= s.totalQualified
          ? money(s.qualifiedCPA)
          : '–'
        %>
      </td>

      <% if (user.role === 'admin') { %>
        <td>
          <%= c.owner ? c.owner.name : '–' %>
        </td>
      <% } %>

      <td class="n">
        <a href="/campaigns/<%= c._id %>/edit">Edit</a>
      </td>

    </tr>

  <% }); %>

  </tbody>

</table>
</div>

<% } %>

<%- include('../partials/footer') %>